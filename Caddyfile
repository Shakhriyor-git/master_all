{$DOMAIN} {
    encode gzip

    handle /health* {
        reverse_proxy api:8000
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle /docs* {
        reverse_proxy api:8000
    }
    handle /openapi.json {
        reverse_proxy api:8000
    }
    handle /media/* {
        reverse_proxy api:8000
    }
    handle /tg/* {
        reverse_proxy api:8000
    }

    handle {
        root * /srv/frontend

        # Vite hashlangan fayllar — nomi o'zgarmasa mazmuni ham o'zgarmaydi
        @assets path /assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"

        # Qolgan hamma narsa (index.html, version.json, SPA yo'llari) — har
        # ochilishda serverdan tekshirilsin. DIQQAT: `header` Caddy'da
        # try_files dan OLDIN ishlaydi, shuning uchun /index.html emas,
        # "assets emas" bo'yicha moslaymiz.
        @page not path /assets/*
        header @page Cache-Control "no-cache, no-store, must-revalidate"

        try_files {path} /index.html
        file_server
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
